# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to use the local Firebase emulators instead (npm run emulators)
VITE_FIREBASE_EMULATORS=

# Page-view stats (optional): your GoatCounter endpoint, e.g. https://CODE.goatcounter.com/count
VITE_GOATCOUNTER=
